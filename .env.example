# Supabase (비워두면 로컬 개발 모드: 개발용 로그인 + .data/dev-db.json)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용. 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것
SUPABASE_SECRET_KEY=

# 운영 빌드에서 Supabase 없이 개발용 로그인을 허용하려면 1 (테스트 배포용)
# ALLOW_DEV_LOGIN=1

# 시나리오 라이브러리 생성 스크립트용 (서비스 실행에는 필요 없음)
GEMINI_API_KEY=
